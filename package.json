{
  "name": "trading-bots",
  "version": "0.1.0",
  "private": true,
  "description": "THETA paper-first options trading control plane",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker/index.js",
    "worker:dev": "tsx src/worker/index.ts",
    "worker:windows:provision": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows/provision-theta-local-worker-token.ps1",
    "worker:windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows/install-theta-local-worker.ps1",
    "worker:windows:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows/start-theta-local-worker.ps1",
    "worker:windows:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows/stop-theta-local-worker.ps1",
    "worker:windows:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows/status-theta-local-worker.ps1",
    "worker:windows:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows/uninstall-theta-local-worker.ps1",
    "worker:deployment-readiness": "node --import tsx tools/worker-deployment-readiness.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src tests public/assets",
    "test:browser": "playwright test",
    "scan:security": "node tools/security-scan.mjs",
    "validate:env": "tsx src/config/validate-env.ts",
    "provider:readiness": "tsx src/providers/provider-readiness.ts",
    "theta:shadow:once": "tsx src/theta/theta-shadow-once.ts",
    "theta:audit:wiring": "tsx tools/theta-runtime-wiring-audit.ts",
    "theta:audit:unknowns": "tsx tools/theta-pre-vps-unknown-audit.ts",
    "theta:truth": "tsx tools/theta-system-truth.ts",
    "theta:truth:profitability-brain": "tsx tools/theta-profitability-brain-reality.ts",
    "theta:truth-runtime": "tsx tools/theta-runtime-truth.ts --environment-file=.env.local",
    "theta:storage:audit": "node --import tsx tools/theta-storage-audit.ts --environment-file=.env.local",
    "theta:storage:dependencies": "node --import tsx tools/theta-postgres-dependency-audit.ts",
    "theta:storage:archive-frontiers": "node --import tsx tools/archive-canonical-strategy-frontiers.ts",
    "theta:storage:compact-research": "python tools/compact-local-research-spool.py",
    "theta:aegis:baseline-progress": "tsx tools/theta-aegis-baseline-progress.ts --environment-file=.env.local",
    "theta:aegis:next-session-eligibility": "tsx tools/theta-aegis-next-session-eligibility.ts --environment-file=.env.local",
    "theta:aegis:iv-backfill": "node --import tsx tools/backfill-aegis-iv-stress.ts --environment-file=.env.local",
    "db:migrate": "node tools/database-migrate.mjs",
    "db:migrate:production:checkpoint": "pwsh -NoProfile -File tools/windows/dr/Invoke-ThetaProductionMigration.ps1",
    "db:verify": "node tools/database-verify.mjs",
    "db:aiven:preflight": "node tools/database-target-preflight.mjs --environment-file=.env.local",
    "db:aiven:import-legacy": "node tools/import-legacy-research-export.mjs",
    "db:neon:recover": "node tools/neon-legacy-recovery.mjs",
    "db:neon:method-sweep": "node tools/neon-legacy-method-sweep.mjs",
    "db:aiven:import-neon-manifest": "node tools/import-legacy-control-plane-manifest.mjs",
    "db:aiven:promote-legacy": "node tools/promote-legacy-research-history.mjs",
    "db:legacy:reconstruct": "node --import tsx tools/legacy-reconstruction-sweep.ts",
    "db:aiven:import-reconstruction": "node tools/import-legacy-reconstruction-manifest.mjs",
    "db:legacy:forensic": "node --import tsx tools/local-forensic-recovery-sweep.ts",
    "db:aiven:import-forensic": "node tools/import-local-forensic-recovery.mjs",
    "paper:designate-master": "tsx tools/designate-master-paper.ts",
    "paper:verify-master": "tsx tools/verify-stored-master-paper.ts",
    "r6:readiness": "node --env-file=.env.local --import tsx tools/r6-readiness.ts",
    "p2d:resolve": "node --env-file=.env.local --import tsx tools/p2d-outcome-resolve.ts",
    "shadow:readiness": "node --import tsx tools/shadow-runtime-readiness.ts --environment-file=.env.local",
    "shadow:ensure-context": "node --env-file=.env.local --import tsx tools/ensure-master-shadow-context.ts",
    "theta:research-export": "node --env-file=.env.local --import tsx tools/theta-research-export.ts",
    "theta:research-export:events": "tsx tools/capture-canonical-event-export.ts",
    "theta:research-export:historical-replay": "node --import tsx tools/export-historical-replay.ts --environment-file=.env.local",
    "theta:research-analyze:historical-replay": "node --import tsx tools/summarize-historical-replay.ts",
    "theta:performance:current": "node --import tsx tools/theta-current-performance-receipt.ts --environment-file=.env.local",
    "theta:evidence:durable": "node tools/write-local-durable-evidence.mjs research_exports/latest .theta-local-worker/evidence",
    "theta:evidence:backfill": "node --import tsx tools/theta-local-evidence-backfill.ts --environment-file=.env.local",
    "theta:first-order-preflight": "node --import tsx tools/theta-first-order-preflight.ts",
    "theta:no-submit:probe": "node --import tsx tools/theta-no-submit-probe.ts --environment-file=.env.local",
    "theta:premarket:historical-regressions": "node --import tsx tools/theta-historical-regressions.ts",
    "theta:premarket:session-simulator": "node --import tsx tools/theta-premarket-session-simulator.ts",
    "theta:premarket:accelerated-soak": "node --import tsx tools/theta-accelerated-session-soak.ts",
    "theta:premarket:certify": "node --import tsx tools/theta-premarket-certify.ts",
    "optionomics:quote-qualification": "node --env-file=.env.local --import tsx tools/optionomics-quote-qualification.ts",
    "optionomics:qualify": "node --env-file=.env.local --import tsx tools/theta-optionomics-qualify.ts",
    "quote:qualify": "node --import tsx tools/theta-quote-qualify.ts",
    "p2g:proof": "node --env-file=.env.local --import tsx tools/p2g-proof.ts",
    "theta:risk-policy-study": "node --import tsx tools/theta-risk-policy-study.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^9.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.63.0",
    "@reticlehq/browser": "^2.13.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.37.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
