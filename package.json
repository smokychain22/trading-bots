{
  "name": "trading-bots",
  "version": "0.1.0",
  "private": true,
  "description": "THETA paper-first options trading control plane",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src tests public/assets",
    "test:browser": "playwright test",
    "scan:security": "node tools/security-scan.mjs",
    "validate:env": "tsx src/config/validate-env.ts",
    "provider:readiness": "tsx src/providers/provider-readiness.ts",
    "theta:shadow:once": "tsx src/theta/theta-shadow-once.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^9.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.63.0",
    "@reticlehq/browser": "^2.13.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.37.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
